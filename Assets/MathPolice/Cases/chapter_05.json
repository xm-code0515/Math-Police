        "target": 1
      }
    },
    {
      "name": {
        "zh": "黛安娜",
        "en": "Diana"
      },
      "gender": "female",
      "testimony": {
        "zh": "凶手是维拉或者科尔。",
        "en": "The killer is either Vera or Cole."
      },
      "rule": {
        "kind": "any",
        "terms": [
          {
