{
  "id": "chapter_05",
  "title": {
    "zh": "午夜拍卖会凶案",
    "en": "Murder at the Midnight Auction"
  },
  "summary": {
    "zh": "4名嫌疑人中只有一名犯人；关键供词恰好2真2假。",
    "en": "Exactly one culprit among 4 suspects. Exactly 2 key statements are true."
  },
  "suspectCount": 4,
  "truthCount": 2,
  "culpritIndex": 3,
  "suspects": [
